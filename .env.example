# Supabase Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Agentic execution
# disabled = create visible blocked run records only
# agentic_v1 = run the TypeScript agent ledger/workers
EXECUTION_BACKEND=disabled
AUTOMATION_CONTROL_ENABLED=false

# Cloudflare R2 (document store)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bank-fee-index-documents

# Authentication
BFI_ADMIN_PASSWORD=
BFI_ANALYST_PASSWORD=
BFI_COOKIE_SECRET=generate-a-random-64-char-hex-string

# Cache revalidation
BFI_APP_URL=https://feeinsight.com
BFI_REVALIDATE_TOKEN=generate-a-random-token

# AI providers
ANTHROPIC_API_KEY=

# External data APIs
FRED_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=feeinsight.com

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Internal report/API auth
REPORT_INTERNAL_SECRET=
REPORT_CRON_SECRET=

# Node
NODE_ENV=production

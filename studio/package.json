{
  "name": "feeinsight-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone renderer for the Fee Insight brand explainer. Not part of the Next.js app.",
  "type": "module",
  "scripts": {
    "render": "node render.mjs",
    "stills": "node render.mjs --stills 3,9,17,29,45,57,67,77",
    "proof": "node render.mjs --scale 0.5 --out out/proof.mp4",
    "narrate": "node narrate.mjs",
    "render:vo": "node render.mjs --vo vo/narration.wav"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "peerDependencies": {
    "playwright": "^1.56.0"
  }
}
